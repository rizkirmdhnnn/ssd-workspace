{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSD Workspace",
  "version": "0.1.2",
  "identifier": "com.rizkirmdhn.ssdworkspace",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "Utility",
    "shortDescription": "See what holds an external SSD and eject it safely",
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    }
  },
  "mainBinaryName": "ssd-workspace"
}
